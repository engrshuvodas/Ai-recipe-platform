# ─── Server Configuration ──────────────────────────────────────────────────────
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:
MONGODB_URI=mongodb://localhost:27017/recipe_companion
# Cloud (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/recipe_companion

# ─── JWT Secret (change this to a long random string in production) ───────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ─── Client URL (for CORS) ────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── AI — OpenRouter (GPT-4o) ─────────────────────────────────────────────────
# Get your free key at: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o

# ─── Optional: Google Gemini (fallback AI) ────────────────────────────────────
GEMINI_API_KEY=

# ─── Optional: OpenAI Direct ──────────────────────────────────────────────────
OPENAI_API_KEY=
